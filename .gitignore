# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ipynb_checkpoints/

# Virtual envs
.venv/
venv/
env/

# Per-machine editor/agent settings (the shared .claude/*.md stays tracked)
.claude/settings.local.json

# Run artifacts (keep the directories via .gitkeep, ignore generated contents)
hyperparameters/run_*.json
logs/run_*/
logs/*.out
logs/*.err
logs/slurm/*.out
logs/slurm/*.err
# Werewolf game transcripts (scripts/eval/werewolf_game.py --output)
logs/werewolf_games/
checkpoints/run_*/
checkpoints/**/*.pt
# Werewolf RL runs: ignore single-job runs (train_werewolf_rl.sbatch:
# checkpoints/werewolf_rl/run_*) and everything an always-on run writes
# (launch.*, pool/, learner/, weights/, train/, logs/, heartbeats/, chain/,
# keeper/, ...), but keep each always-on run's game_config.json (its game rules).
checkpoints/werewolf_rl/*
!checkpoints/werewolf_rl/continuous/
checkpoints/werewolf_rl/continuous/*/*
!checkpoints/werewolf_rl/continuous/*/game_config.json

# Local model downloads (e.g. Qwen3-4B pulled from the HF Hub)
models/

# Models / data
*.bin
*.safetensors
data/**/*.jsonl
data/**/*.parquet
!data/README.md
!data/dataset_plan.md

# Release bundles retain checked-in instructions/metadata but not large weights
# or locally-produced archives.
release_artifacts/**/*.zip
release_artifacts/**/model_state.pt
release_artifacts/**/*.safetensors
