# Text-message alerts for the always-on Werewolf RL loop.
#
# 1. Copy this file OUTSIDE the repo and lock it down (already done if
#    ~/.config/werewolf_rl/notify.env exists):
#      mkdir -p ~/.config/werewolf_rl
#      cp scripts/training/werewolf_continuous/notify.env.example ~/.config/werewolf_rl/notify.env
#      chmod 600 ~/.config/werewolf_rl/notify.env
# 2. Fill in the three values marked FILL IN below.
# 3. Send yourself a test text:
#      python -m training.werewolf_rl.notify test
#
# Running jobs read this file each time they send an alert, so changes take
# effect without restarting the run. Empty NOTIFY_PHONE to turn alerts off.

# ---- your phone number (10 digits); used by the textbelt fallback ----
NOTIFY_PHONE=""

# How alerts are sent:
#   ntfy:     free push notifications to the ntfy phone app (no phone number needed).
#             Works straight from the compute nodes over HTTPS.
#   gateway:  free. Emails your carrier's email-to-text address (e.g.
#             5551234567@vtext.com for Verizon) through the Gmail account below,
#             the same mechanism as self-hosted Textbelt, without its server.
#   textbelt: textbelt.com (free key "textbelt" = 1 text per day).
#   twilio:   Twilio account (fill in the TWILIO_ values).
NOTIFY_PROVIDER="ntfy"

# Tried when the main provider fails to hand the message over (e.g. Gmail rejects
# the login). It cannot catch a text Verizon silently drops after Gmail accepted it.
NOTIFY_FALLBACK="textbelt"

# ---- ntfy (free push notifications; the default) ----
# Install the ntfy app (iPhone App Store / Google Play, "ntfy"), tap +, and
# subscribe to NTFY_TOPIC on server ntfy.sh. Anyone who knows the topic name can
# read and post to it, so keep it long and random and don't share it.
NTFY_TOPIC=""
NTFY_SERVER="https://ntfy.sh"
NTFY_TITLE="Werewolf RL"
NTFY_TOKEN=""           # only for a reserved topic or your own ntfy server

# ---- gateway settings ----
# Carrier: verizon (vtext.com, scheduled to shut down 2027-03-31), googlefi, uscellular.
# AT&T's and T-Mobile's gateways are already shut down. Or set NOTIFY_GATEWAY_DOMAIN.
NOTIFY_CARRIER="verizon"
NOTIFY_GATEWAY_DOMAIN=""

# The Gmail account that sends the email-to-text messages:
#   - Turn on 2-Step Verification for that Google account.
#   - Create an app password: https://myaccount.google.com/apppasswords
#     (Google shows 16 letters; spaces don't matter).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"     # 587 is blocked on Rosie; 465 works from the login node
# ---- FILL IN: the Gmail address ----
SMTP_USER=""
# ---- FILL IN: its 16-letter app password (NOT your normal Gmail password) ----
SMTP_PASSWORD=""
SMTP_FROM=""            # defaults to SMTP_USER

# ---- relay (only for NOTIFY_PROVIDER="gateway": Rosie's compute nodes block email) ----
# cron:   jobs queue alerts in NOTIFY_OUTBOX; the login-node cron task
#         (python -m training.werewolf_rl.notify install-cron) emails them every 2 minutes.
# direct: send from wherever the alert happens (only where SMTP works).
NOTIFY_RELAY="direct"
NOTIFY_OUTBOX="~/.config/werewolf_rl/outbox"
# A queued alert that still can't be emailed after this long goes through NOTIFY_FALLBACK.
NOTIFY_FALLBACK_AFTER_MINUTES="10"

# ---- textbelt settings (used as the fallback) ----
TEXTBELT_KEY="textbelt" # free key: 1 text per day; a paid key from textbelt.com allows more

# ---- twilio settings (only if NOTIFY_PROVIDER or NOTIFY_FALLBACK is twilio) ----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""          # the Twilio number that sends the text, e.g. +15557654321

# Which alerts to send (comma-separated):
#   start   - a chain's first job starts running (after start.sh; jobs can wait hours in the queue)
#   crash   - a job ended by crashing (FAILED / OUT_OF_MEMORY / NODE_FAIL / BOOT_FAIL)
#   gave_up - a trainer/player process crashed 3 times in a row and its GPU was left idle
#   stopped - a chain stopped for good (3 crashes in a row)
NOTIFY_EVENTS="start,crash,gave_up,stopped"

# Skip an identical alert sent within this many minutes
NOTIFY_REPEAT_MINUTES="30"
